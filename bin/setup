#!/usr/bin/env bash
# distill setup: install yt-dlp, fetch the Whisper model, prove it loads on the GPU.
# Idempotent. Run from anywhere once direnv has loaded .envrc (or set DISTILL_MODELS yourself).
set -euo pipefail

MODELS="${DISTILL_MODELS:-$(cd "$(dirname "$0")/.." && pwd)/models}"
MODEL_NAME="ggml-large-v3-turbo.bin"
MODEL="${DISTILL_MODEL:-$MODELS/$MODEL_NAME}"
URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$MODEL_NAME"
EXPECTED_SHA1="4af2b29d7ec73d781377bfd1758ca957a807e941"   # published in whisper.cpp/models/download-ggml-model.sh

say() { printf '\033[1m%s\033[0m\n' "$*"; }

say "1/3 Homebrew tools"
for f in ffmpeg whisper.cpp yt-dlp; do
  if brew list --versions "$f" >/dev/null 2>&1; then
    echo "  ok   $f $(brew list --versions "$f" | awk '{print $2}')"
  else
    echo "  ...  installing $f"; brew install "$f"
  fi
done

say "2/3 Whisper model → $MODEL"
mkdir -p "$(dirname "$MODEL")"
if [[ -f "$MODEL" ]]; then
  echo "  ok   already present ($(du -h "$MODEL" | cut -f1))"
else
  curl -L --fail --progress-bar -o "$MODEL.part" "$URL"
  mv "$MODEL.part" "$MODEL"
fi
actual="$(shasum -a 1 "$MODEL" | cut -d' ' -f1)"
if [[ "$actual" != "$EXPECTED_SHA1" ]]; then
  echo "  !!   sha1 mismatch: $actual (expected $EXPECTED_SHA1). Delete the file and rerun." >&2; exit 1
fi
echo "  ok   sha1 $actual, $(stat -f%z "$MODEL") bytes"

say "3/3 Load test (should say 'use gpu = 1' and name your GPU)"
sample="$(brew --prefix whisper.cpp)/share/whisper.cpp/jfk.wav"
log="$(mktemp)"
whisper-cli -m "$MODEL" -f "$sample" >"$log" 2>&1 || { cat "$log"; exit 1; }
grep -E 'GPU name|use gpu|total time' "$log" | sed 's/^/  /'
grep -q 'use gpu    = 1' "$log" && echo "  ok   Metal" || echo "  !!   GPU not used; check whisper.cpp build" >&2
rm -f "$log"
