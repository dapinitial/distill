# distill: direnv loads this on cd (run `direnv allow` once).
# Scripts in bin/ are on PATH; models and caches stay inside the repo's ignored dirs.
PATH_add bin
export DISTILL_HOME="$PWD"
export DISTILL_MODELS="$PWD/models"         # whisper.cpp ggml models (gitignored)
export DISTILL_MODEL="${DISTILL_MODEL:-$DISTILL_MODELS/ggml-large-v3-turbo.bin}"
export DISTILL_OUT="${DISTILL_OUT:-$PWD/out}" # transcripts and cliff notes land here (gitignored)
dotenv_if_exists .env                       # local overrides, never committed
