#!/usr/bin/env python3
"""transcribe: a media file or URL -> an LLM-ready transcript folder.

  transcribe <file-or-url> [--out DIR] [--slug NAME] [--lang en] [--glossary FILE]
                           [--threads N] [--force] [--section-target 180]

Pipeline: yt-dlp (audio only, URLs) -> ffmpeg 16 kHz mono WAV -> whisper-cli (large-v3-turbo,
full JSON) -> deterministic cleanup (whitespace, stutters, fillers, glossary) -> sentences ->
sections at natural pauses -> transcript.md, transcript.json, chunks.jsonl, source.json.
No speaker labels (v1). Nothing leaves this machine.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from distill_common import hms, norm_token, slugify  # noqa: E402

HERE = Path(__file__).resolve().parent
HOME = Path(os.environ.get("DISTILL_HOME", HERE.parent))
URL_RE = re.compile(r"^https?://", re.I)
EOT = 50257  # whisper multilingual vocab: ids >= EOT are special/timestamp tokens
FILLERS = {"um", "uh", "umm", "uhh", "erm", "uhm", "mm", "mhm"}
STUTTER_OK = {"that", "had", "very", "no", "bye", "ha", "so", "really", "many", "is"}
NONSPEECH_RE = re.compile(r"^\s*[\[\(\*].*[\]\)\*]\s*$")
SUSPECT_GAP = 5.0   # seconds of silence isolating a first/last segment
SUSPECT_P = 0.15    # token probability below which whisper is guessing
LOW_P = 0.2         # words reported as low confidence


def log(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=True, text=True, **kw)


class Timer:
    def __init__(self) -> None:
        self.t: dict[str, float] = {}
        self._start = time.monotonic()

    def step(self, name: str, fn):
        t0 = time.monotonic()
        out = fn()
        self.t[name] = round(time.monotonic() - t0, 1)
        log(f"  {name}: {self.t[name]}s")
        return out

    def total(self) -> float:
        return round(time.monotonic() - self._start, 1)


# ---------- 1. source ----------------------------------------------------------------------

def probe_duration(path: Path) -> float:
    out = run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "json", str(path)],
              capture_output=True).stdout
    return float(json.loads(out)["format"]["duration"])


def resolve_source(inp: str, out_root: Path, slug_override: str | None, force: bool, timer: Timer,
                   playlist_ok: bool = False, video: bool = False):
    """Return (source dict, media path, out dir); for a playlist, (info, None, None)."""
    if URL_RE.match(inp):
        info = json.loads(timer.step("probe", lambda: run(
            ["yt-dlp", "--no-warnings", "-J", inp] + ([] if playlist_ok else ["--no-playlist"]),
            capture_output=True).stdout))
        if info.get("_type") == "playlist":
            return info, None, None  # caller expands the entries
        title = info.get("title") or "untitled"
        slug = slug_override or slugify(title)
        if not slug_override and info.get("id"):
            for prev in out_root.glob("*/source.json"):  # same video under an older title: reuse its folder
                try:
                    if json.loads(prev.read_text()).get("id") == info["id"] and prev.parent.name != slug:
                        slug = prev.parent.name
                        log(f"  already transcribed as {slug}; reusing that folder")
                        break
                except (OSError, ValueError):
                    continue
        out_dir = out_root / slug
        media_dir = out_dir / "media"
        media_dir.mkdir(parents=True, exist_ok=True)
        existing = [p for p in media_dir.glob("audio.*") if p.suffix not in (".part", ".vtt")]
        if existing and not force:
            media = existing[0]
            log(f"  download: skipped, have {media.name}")
        else:
            def dl():
                try:
                    run(["yt-dlp", "--no-playlist", "--no-warnings", "--quiet", "--no-progress", "-f", "bestaudio/best",
                         "-o", str(media_dir / "audio.%(ext)s"), inp], capture_output=True)
                except subprocess.CalledProcessError as e:
                    tail = (e.stderr or "").strip().splitlines()[-1:] or ["no error text"]
                    sys.exit(f"transcribe: yt-dlp could not download the audio: {tail[0]}\n"
                             "  If this is a YouTube change, run: brew upgrade yt-dlp")
                # captions are a bonus: exact language codes only (a wildcard pulls dozens of
                # auto-translations and trips YouTube's rate limit), and failure is not fatal
                subprocess.run(["yt-dlp", "--no-playlist", "--no-warnings", "--quiet", "--skip-download",
                                "--write-subs", "--write-auto-subs", "--sub-langs", "en-orig,en", "--sub-format", "vtt",
                                "-o", str(media_dir / "audio.%(ext)s"), inp], capture_output=True)
                return [p for p in media_dir.glob("audio.*") if p.suffix not in (".part", ".vtt")][0]
            media = timer.step("download", dl)
        have_video = [p for p in media_dir.glob("video.*") if p.suffix != ".part"]
        if video and (not have_video or force):
            timer.step("video", lambda: run(["yt-dlp", "--no-playlist", "--no-warnings", "--quiet", "--no-progress",
                                             "-f", "bestvideo[height<=720]+bestaudio/best[height<=720]/best",
                                             "-o", str(media_dir / "video.%(ext)s"), inp]))
        source = {
            "title": title,
            "url": info.get("webpage_url") or inp,
            "path": None,
            "duration": float(info.get("duration") or probe_duration(media)),
            "site": info.get("extractor_key"),
            "id": info.get("id"),
            "uploader": info.get("uploader") or info.get("channel"),
            "upload_date": info.get("upload_date"),
            "chapters": [{"title": c.get("title"), "start": float(c["start_time"]), "end": float(c["end_time"])}
                         for c in (info.get("chapters") or [])],
            "captions": next((str(p.relative_to(out_dir)) for p in sorted(media_dir.glob("audio*.vtt"))), None),
        }
    else:
        path = Path(inp).expanduser().resolve()
        if not path.exists():
            sys.exit(f"transcribe: no such file: {path}")
        title = path.stem
        slug = slug_override or slugify(title)
        out_dir = out_root / slug
        out_dir.mkdir(parents=True, exist_ok=True)
        media = path
        source = {"title": title, "url": None, "path": str(path), "duration": probe_duration(path),
                  "site": None, "id": None, "uploader": None, "upload_date": None, "chapters": [], "captions": None}
    return source, media, out_dir


# ---------- 2. audio + 3. whisper ----------------------------------------------------------

def to_wav(media: Path, wav: Path, force: bool, timer: Timer) -> None:
    if wav.exists() and not force:
        log("  ffmpeg: skipped, have audio.wav")
        return
    timer.step("ffmpeg", lambda: run(
        ["ffmpeg", "-y", "-loglevel", "error", "-i", str(media), "-vn", "-ac", "1", "-ar", "16000",
         "-c:a", "pcm_s16le", str(wav)]))


PROMPT = "Hello, and welcome. Today we're talking about what happened, why it matters, and what comes next."


def whisper(wav: Path, prefix: Path, model: Path, lang: str, threads: int, force: bool, timer: Timer,
            prompt: str = PROMPT) -> dict:
    out = prefix.with_suffix(".json")
    if out.exists() and not force:
        log("  whisper: skipped, have whisper.json (use --force to redo)")
    else:
        if not model.exists():
            sys.exit(f"transcribe: model not found at {model} (run bin/setup)")
        cmd = ["whisper-cli", "-m", str(model), "-f", str(wav), "-l", lang, "-t", str(threads),
               "-oj", "-ojf", "-of", str(prefix), "-np", "-pp", "--prompt", prompt]
        timer.step("whisper", lambda: run(cmd, stdout=subprocess.DEVNULL,
                                           stderr=open(prefix.with_suffix(".log"), "w")))
    return json.loads(out.read_text())


# ---------- 4. tokens -> words -------------------------------------------------------------

def words_from_whisper(data: dict) -> tuple[list[dict], list[dict], list[dict]]:
    """Merge whisper tokens into words. Returns (words, dropped_suspect_segments, suspect_mid_segments)."""
    segs: list[list[dict]] = []
    for seg in data["transcription"]:
        if NONSPEECH_RE.match(seg["text"]) or not seg["text"].strip():
            continue
        words: list[dict] = []
        cur: dict | None = None
        for tok in seg["tokens"]:
            text = tok["text"]
            if tok["id"] >= EOT or text.startswith("[_") or not text.strip():
                continue
            t0, t1 = tok["offsets"]["from"] / 1000, tok["offsets"]["to"] / 1000
            if text.startswith(" ") or cur is None:
                cur = {"word": text.strip(), "start": t0, "end": t1, "p": tok["p"]}
                words.append(cur)
            else:  # continuation of a word, or punctuation glued to it
                cur["word"] += text
                cur["end"] = max(cur["end"], t1)
                cur["p"] = min(cur["p"], tok["p"])
        if words:
            segs.append(words)

    # Whisper hallucinates on silence: subtitle credits before the talk starts, "Thanks for
    # watching" after it ends. Drop a first/last segment that is isolated by >= 5 s of silence
    # and contains a word the model itself barely believed (p < 0.15). Keep a record.
    dropped: list[dict] = []
    def suspect(seg, neighbour, lead):
        gap = (neighbour[0]["start"] - seg[-1]["end"]) if lead else (seg[0]["start"] - neighbour[-1]["end"])
        return gap >= SUSPECT_GAP and min(w["p"] for w in seg) < SUSPECT_P
    while len(segs) > 1 and suspect(segs[0], segs[1], True):
        dropped.append(segs.pop(0))
    while len(segs) > 1 and suspect(segs[-1], segs[-2], False):
        dropped.append(segs.pop())

    # inside the talk, an isolated low-confidence segment is reported but kept: it may be real speech after a music break
    suspect_mid = []
    for k in range(1, len(segs) - 1):
        gap_before = segs[k][0]["start"] - segs[k - 1][-1]["end"]
        gap_after = segs[k + 1][0]["start"] - segs[k][-1]["end"]
        if min(gap_before, gap_after) >= SUSPECT_GAP and min(w["p"] for w in segs[k]) < SUSPECT_P:
            suspect_mid.append({"start": round(segs[k][0]["start"], 2), "end": round(segs[k][-1]["end"], 2),
                                "text": " ".join(w["word"] for w in segs[k]), "min_p": round(min(w["p"] for w in segs[k]), 3)})

    words = [w for seg in segs for w in seg]
    for i, w in enumerate(words):  # keep times monotonic and sane
        if i and w["start"] < words[i - 1]["start"]:
            w["start"] = words[i - 1]["start"]
        if w["end"] < w["start"]:
            w["end"] = w["start"]
    dropped_info = [{"start": round(d[0]["start"], 2), "end": round(d[-1]["end"], 2),
                     "text": " ".join(w["word"] for w in d), "min_p": round(min(w["p"] for w in d), 3)}
                    for d in dropped]
    return drop_inline_nonspeech(words), dropped_info, suspect_mid


def drop_inline_nonspeech(words: list[dict]) -> list[dict]:
    """Remove '(laughs)', '[Music]', '♪' when they appear inside a segment (span of <= 4 words)."""
    out, i = [], 0
    while i < len(words):
        w = words[i]["word"]
        if w and w[0] in "([" :
            for j in range(i, min(i + 4, len(words))):
                if words[j]["word"].rstrip(".,!?").endswith((")", "]")):
                    i = j + 1
                    break
            else:
                out.append(words[i]); i += 1
            continue
        if w.strip("♪♫ ") == "":
            i += 1; continue
        out.append(words[i]); i += 1
    return out


# ---------- 5. deterministic cleanup -------------------------------------------------------

TERMINAL = ".?!"


def _move_trailing_punct(src: dict, dst: dict | None) -> None:
    m = re.search(r"[.,!?;:]+$", src["word"])
    if m and dst is not None and not re.search(r"[.,!?;:]$", dst["word"]):
        dst["word"] += m.group(0)


def remove_fillers(words: list[dict]) -> tuple[list[dict], int]:
    out: list[dict] = []
    removed = 0
    for w in words:
        if norm_token(w["word"]) in FILLERS:
            _move_trailing_punct(w, out[-1] if out else None)
            removed += 1
            continue
        out.append(w)
    return out, removed


def remove_stutters(words: list[dict], max_n: int = 3) -> tuple[list[dict], int]:
    """'I I I think' -> 'I think'; 'you know you know' -> 'you know'. Keeps the last copy."""
    removed = 0
    i = 0
    out = list(words)
    while i < len(out):
        hit = False
        for n in range(max_n, 0, -1):
            if i + 2 * n > len(out):
                continue
            a = [norm_token(x["word"]) for x in out[i:i + n]]
            b = [norm_token(x["word"]) for x in out[i + n:i + 2 * n]]
            if a != b or not all(a):
                continue
            if n == 1 and a[0] in STUTTER_OK:
                continue
            if any(re.search(r"[.?!]$", x["word"]) for x in out[i:i + n]):
                continue  # 'No. No.' is emphasis, not a stutter
            out[i + n]["start"] = out[i]["start"]
            del out[i:i + n]
            removed += n
            hit = True
            break
        if not hit:
            i += 1
    return out, removed


def load_glossary(paths: list[Path]) -> list[tuple[list[str], str]]:
    rules: dict[tuple[str, ...], str] = {}
    for p in paths:
        for raw in p.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if m := re.match(r"^(.+?)\s*(?:→|->|=>)\s*(.+)$", line):
                wrong, right = m.group(1).strip(), m.group(2).strip()
            else:
                wrong = right = line
            key = tuple(norm_token(t) for t in wrong.split())
            if all(key):
                rules[key] = right
    return sorted(rules.items(), key=lambda kv: -len(kv[0]))  # longest phrase first


def apply_glossary(words: list[dict], rules: list[tuple[tuple[str, ...], str]]) -> tuple[list[dict], int]:
    if not rules:
        return words, 0
    by_len: dict[int, dict[tuple[str, ...], str]] = {}
    for key, right in rules:
        by_len.setdefault(len(key), {})[key] = right
    lens = sorted(by_len, reverse=True)
    norms = [norm_token(w["word"]) for w in words]
    out: list[dict] = []
    i = 0
    changed = 0
    while i < len(words):
        matched = False
        for n in lens:
            key = tuple(norms[i:i + n])
            right = by_len[n].get(key)
            if right is None:
                continue
            span = words[i:i + n]
            lead = re.match(r"^[^\w$]*", span[0]["word"]).group(0)
            trail = re.search(r"[^\w%]*$", span[-1]["word"]).group(0)
            parts = right.split()
            produced = [(lead if k == 0 else "") + p + (trail if k == len(parts) - 1 else "") for k, p in enumerate(parts)]
            if produced != [w["word"] for w in span]:
                changed += 1
            s, e = span[0]["start"], span[-1]["end"]
            step = (e - s) / len(parts) if parts else 0
            for k, text in enumerate(produced):
                out.append({"word": text,
                            "start": round(s + k * step, 3), "end": round(s + (k + 1) * step, 3),
                            "p": min(w["p"] for w in span)})
            i += n
            matched = True
            break
        if not matched:
            out.append(words[i]); i += 1
    return out, changed


def tidy(words: list[dict]) -> list[dict]:
    """Whitespace and stray punctuation: no empty words, no doubled spaces, no lone commas."""
    out: list[dict] = []
    for w in words:
        text = re.sub(r"\s+", " ", w["word"]).strip()
        if not text:
            continue
        if re.fullmatch(r"[.,!?;:]+", text) and out:  # whisper sometimes emits ' .' as its own token
            out[-1]["word"] += text
            out[-1]["end"] = max(out[-1]["end"], w["end"])
            continue
        w = dict(w, word=text)
        out.append(w)
    return out


# ---------- 6. sentences, 7. sections -----------------------------------------------------

SENT_END = re.compile(r"[.?!][\"')\]]*$")


def absorb_minor_speakers(turns: list[dict]) -> tuple[list[dict], int]:
    """Diarization on crosstalk invents speakers for a few seconds of audio. Fold anyone with under
    5 s or under 3% of the speech into whoever spoke just before (or after, at the start)."""
    total: dict[int, float] = {}
    for t in turns:
        total[t["speaker"]] = total.get(t["speaker"], 0.0) + (t["end"] - t["start"])
    speech = sum(total.values()) or 1.0
    minor = {s for s, secs in total.items() if secs < 5.0 or secs / speech < 0.03}
    if len(total) - len(minor) < 1:
        return turns, 0
    out = [dict(t) for t in turns]
    for i, t in enumerate(out):
        if t["speaker"] in minor:
            prev = next((x["speaker"] for x in reversed(out[:i]) if x["speaker"] not in minor), None)
            nxt = next((x["speaker"] for x in out[i + 1:] if x["speaker"] not in minor), None)
            t["speaker"] = prev if prev is not None else nxt
    # renumber by first appearance
    order: dict[int, int] = {}
    for t in out:
        order.setdefault(t["speaker"], len(order))
        t["speaker"] = order[t["speaker"]]
    # merge adjacent same-speaker turns
    merged: list[dict] = []
    for t in out:
        if merged and merged[-1]["speaker"] == t["speaker"] and t["start"] - merged[-1]["end"] < 1.0:
            merged[-1]["end"] = max(merged[-1]["end"], t["end"])
        else:
            merged.append(t)
    return merged, len(minor)


def assign_speakers(words: list[dict], turns: list[dict]) -> None:
    """Each word takes the speaker whose segment overlaps it most; gaps inherit the previous word."""
    j = 0
    last = 0
    for w in words:
        best, best_ov = None, 0.0
        while j < len(turns) and turns[j]["end"] < w["start"] - 1.0:
            j += 1
        for t in turns[j:j + 6]:
            ov = min(w["end"], t["end"]) - max(w["start"], t["start"])
            if ov > best_ov:
                best, best_ov = t["speaker"], ov
        if best is None:  # no overlap: nearest segment edge within 1 s, else carry on
            near = min(turns, key=lambda t: min(abs(t["start"] - w["start"]), abs(t["end"] - w["end"])), default=None)
            best = near["speaker"] if near and min(abs(near["start"] - w["start"]), abs(near["end"] - w["end"])) < 1.0 else last
        w["speaker"] = best
        last = best


def sentences(words: list[dict], max_gap: float = 2.0, max_len: float = 45.0) -> list[dict]:
    sents: list[dict] = []
    cur: list[dict] = []
    for idx, w in enumerate(words):
        cur.append(w)
        nxt = words[idx + 1] if idx + 1 < len(words) else None
        ends = SENT_END.search(w["word"]) is not None
        gap = (nxt["start"] - w["end"]) if nxt else 0
        too_long = (w["end"] - cur[0]["start"]) > max_len and gap > 0.6
        switch = nxt is not None and "speaker" in w and nxt.get("speaker") != w["speaker"] and len(cur) >= 3
        if ends or gap > max_gap or too_long or switch or nxt is None:
            spk = None
            if "speaker" in cur[0]:
                counts: dict[int, int] = {}
                for x in cur:
                    counts[x["speaker"]] = counts.get(x["speaker"], 0) + 1
                spk = max(counts, key=counts.get)
            sents.append({"start": cur[0]["start"], "end": cur[-1]["end"],
                          "text": " ".join(x["word"] for x in cur), "n": len(cur),
                          "gap_after": gap if nxt else 0.0, "speaker": spk})
            cur = []
    return sents


def sections(sents: list[dict], target: float, lo: float, hi: float) -> list[list[dict]]:
    """Greedy: after `lo` seconds, cut at the sentence boundary with the longest pause,
    nudged toward `target`; never later than `hi`."""
    out: list[list[dict]] = []
    i = 0
    while i < len(sents):
        start = sents[i]["start"]
        best, best_score = None, None
        j = i
        while j < len(sents):
            dur = sents[j]["end"] - start
            if dur >= lo:
                score = sents[j]["gap_after"] - abs(dur - target) / 120.0
                if best_score is None or score > best_score:
                    best, best_score = j, score
            if dur >= hi:
                break
            j += 1
        cut = best if best is not None else min(j, len(sents) - 1)
        out.append(sents[i:cut + 1])
        i = cut + 1
    # don't leave a stub at the end
    if len(out) > 1 and out[-1][-1]["end"] - out[-1][0]["start"] < lo / 2:
        out[-2].extend(out.pop())
    return out


def sections_from_chapters(sents: list[dict], chapters: list[dict], target: float, lo: float, hi: float) -> list[list[dict]]:
    """Cut at the creator's chapter marks, snapped to the nearest sentence boundary. Chapters shorter
    than 30 s merge forward; chapters longer than 1.5x the max are split by the pause rule."""
    marks = sorted(c["start"] for c in chapters if c["start"] > 0)
    titles = {c["start"]: c.get("title") for c in chapters}
    bounds: list[int] = []  # sentence index where a new section starts
    for m in marks:
        i = min(range(len(sents)), key=lambda k: abs(sents[k]["start"] - m))
        if i and (not bounds or i > bounds[-1]):
            bounds.append(i)
    groups: list[list[dict]] = []
    prev = 0
    for b in bounds + [len(sents)]:
        if b > prev:
            groups.append(sents[prev:b]); prev = b
    merged: list[list[dict]] = []
    for g in groups:
        if merged and (merged[-1][-1]["end"] - merged[-1][0]["start"]) < 30:
            merged[-1].extend(g)
        else:
            merged.append(g)
    out: list[list[dict]] = []
    for g in merged:
        if g[-1]["end"] - g[0]["start"] > hi * 1.5:
            out.extend(sections(g, target, lo, hi))
        else:
            out.append(g)
    # attach the chapter title to the section that starts nearest its mark
    for sec in out:
        near = min(marks + [0.0], key=lambda m: abs(sec[0]["start"] - m)) if marks else 0.0
        sec_title = titles.get(near) if abs(sec[0]["start"] - near) < 20 else None
        sec[0]["chapter"] = sec_title
    if out and out[0][0].get("chapter") is None and chapters and chapters[0]["start"] == 0:
        out[0][0]["chapter"] = chapters[0].get("title")
    return out


def paragraphs(sents: list[dict], min_len: float = 20.0, max_len: float = 75.0, gap: float = 1.2) -> list[list[dict]]:
    paras: list[list[dict]] = []
    cur: list[dict] = []
    for s in sents:
        if cur and s.get("speaker") is not None and s["speaker"] != cur[-1].get("speaker"):
            paras.append(cur); cur = []
        cur.append(s)
        dur = cur[-1]["end"] - cur[0]["start"]
        if (dur >= min_len and s["gap_after"] >= gap) or dur >= max_len:
            paras.append(cur); cur = []
    if cur:
        paras.append(cur)
    return paras


# ---------- 8. write -----------------------------------------------------------------------

def labelled(sents: list[dict]) -> str:
    """Sentences joined, with 'Speaker N:' wherever the speaker changes."""
    out, last = [], None
    for s in sents:
        if s.get("speaker") is not None and s["speaker"] != last:
            out.append(f"Speaker {s['speaker'] + 1}:")
            last = s["speaker"]
        out.append(s["text"])
    return " ".join(out)


def write_outputs(out_dir: Path, source: dict, words: list[dict], secs: list[list[dict]]) -> None:
    hours = source["duration"] >= 3600
    sec_records = []
    for k, sec in enumerate(secs, 1):
        sec_records.append({
            "index": k, "start": round(sec[0]["start"], 2), "end": round(sec[-1]["end"], 2),
            "start_hms": hms(sec[0]["start"], hours), "end_hms": hms(sec[-1]["end"], hours),
            "text": labelled(sec), "word_count": sum(s["n"] for s in sec),
            "title": sec[0].get("chapter"),
        })

    with (out_dir / "chunks.jsonl").open("w") as f:
        for r in sec_records:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")

    (out_dir / "transcript.json").write_text(json.dumps({
        "title": source["title"], "url": source["url"], "duration": source["duration"],
        "words": [{"word": w["word"], "start": round(w["start"], 2), "end": round(w["end"], 2), "p": round(w["p"], 2),
                   **({"speaker": w["speaker"]} if "speaker" in w else {})} for w in words],
        "sections": [{k: v for k, v in r.items() if k != "text"} for r in sec_records],
    }, ensure_ascii=False))

    lines = [f"# {source['title']}", ""]
    meta = [f"Duration {hms(source['duration'], hours)}", f"Model {source['model']}",
            f"{source['speaker_count']} speakers, detected and numbered" if source.get("speaker_count") else "No speaker labels"]
    if source["url"]:
        lines.append(f"Source: {source['url']}  ")
    lines += [" · ".join(meta), ""]
    for r, sec in zip(sec_records, secs):
        lines += [f"## {r['index']}. [{r['start_hms']}–{r['end_hms']}]" + (f" {r['title']}" if r.get("title") else ""), ""]
        for para in paragraphs(sec):
            label = f"**Speaker {para[0]['speaker'] + 1}:** " if para[0].get("speaker") is not None else ""
            lines += [f"[{hms(para[0]['start'], hours)}] {label}" + " ".join(s["text"] for s in para), ""]
    (out_dir / "transcript.md").write_text("\n".join(lines).rstrip() + "\n")
    (out_dir / "source.json").write_text(json.dumps(source, indent=2, ensure_ascii=False) + "\n")


# ---------- main ---------------------------------------------------------------------------

def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", help="media file or URL")
    ap.add_argument("--out", default=os.environ.get("DISTILL_OUT", str(HOME / "out")), help="output root")
    ap.add_argument("--slug", help="folder name under --out (default: from the title)")
    ap.add_argument("--lang", default="en", help="language code, or 'auto'")
    ap.add_argument("--model", default=os.environ.get("DISTILL_MODEL", str(HOME / "models/ggml-large-v3-turbo.bin")))
    ap.add_argument("--glossary", action="append", default=[], help="extra glossary file (repeatable)")
    ap.add_argument("--threads", type=int, default=min(8, os.cpu_count() or 4))
    ap.add_argument("--section-target", type=float, default=180, help="ideal section length, seconds")
    ap.add_argument("--section-min", type=float, default=90)
    ap.add_argument("--section-max", type=float, default=300)
    ap.add_argument("--force", action="store_true", help="redo download, wav and whisper even if cached")
    ap.add_argument("--playlist", action="store_true", help="a playlist or channel URL: transcribe every entry")
    ap.add_argument("--video", action="store_true", help="keep the video too (720p) so render can grab frames")
    ap.add_argument("--no-chapters", action="store_true", help="ignore the creator's chapter marks")
    ap.add_argument("--no-glossary", action="store_true", help="skip glossary rules (to see what Whisper said raw)")
    ap.add_argument("--speakers", nargs="?", const=-1, type=int, default=None, metavar="N",
                    help="label speakers (numbered, not named); give N when you know how many")
    ap.add_argument("--speaker-threshold", type=float, default=0.5,
                    help="clustering threshold when detecting speakers; lower splits more (0.3–0.8)")
    ap.add_argument("--no-speakers", action="store_true", help="ignore an existing speakers.json")
    ap.add_argument("--prompt", default=PROMPT, help="initial prompt for Whisper; a punctuated sentence keeps it "
                    "producing punctuation and capitals, and it can carry names (see glossary) and jargon")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()
    if a.quiet:
        global log
        log = lambda msg: None  # noqa: E731

    for tool in ("ffmpeg", "ffprobe", "whisper-cli") + (("yt-dlp",) if URL_RE.match(a.input) else ()):
        if not shutil.which(tool):
            sys.exit(f"transcribe: {tool} not on PATH (run bin/setup)")

    timer = Timer()
    log(f"transcribe: {a.input}")
    source, media, out_dir = resolve_source(a.input, Path(a.out).expanduser(), a.slug, a.force, timer,
                                            playlist_ok=a.playlist, video=a.video)
    if media is None:  # a playlist: run each entry as its own transcribe so one failure doesn't stop the rest
        entries = [e for e in source.get("entries") or [] if e and (e.get("url") or e.get("webpage_url"))]
        log(f"  playlist \"{source.get('title')}\": {len(entries)} entries")
        passthrough = [x for x in sys.argv[1:] if x not in (a.input, "--playlist")]
        failed = 0
        for i, e in enumerate(entries, 1):
            url = e.get("webpage_url") or e["url"]
            log(f"\n[{i}/{len(entries)}] {e.get('title') or url}")
            r = subprocess.run([sys.executable, __file__, url] + [x for x in passthrough if x != a.slug])
            failed += r.returncode != 0
        sys.exit(1 if failed else 0)
    log(f"  → {out_dir}")
    wav = out_dir / "audio.wav"
    to_wav(media, wav, a.force, timer)
    model = Path(a.model).expanduser()
    raw = whisper(wav, out_dir / "whisper", model, a.lang, a.threads, a.force, timer, a.prompt)
    turns: list[dict] = []
    dz = out_dir / "speakers.json"
    if a.speakers is None and dz.exists() and not a.no_speakers:
        a.speakers = -1  # labelled once, stays labelled on reruns
    if a.speakers is not None:
        if dz.exists() and not a.force:
            log("  speakers: skipped, have speakers.json")
        else:
            def diarize():
                cmd = [str(HERE / "diarize"), str(wav), "--threshold", str(a.speaker_threshold)] + \
                      (["--speakers", str(a.speakers)] if a.speakers > 0 else [])
                dz.write_text(run(cmd, capture_output=True).stdout)
            timer.step("speakers", diarize)
        turns, folded = absorb_minor_speakers(json.loads(dz.read_text()))
        if folded:
            log(f"  speakers: folded {folded} minor voice(s) into their neighbours")

    def post():
        words, dropped, suspect_mid = words_from_whisper(raw)
        words = tidy(words)
        n_raw = len(words)
        words, n_fill = remove_fillers(words)
        words, n_stut = remove_stutters(words)
        gl_paths = [Path(p) for p in a.glossary] + [Path.cwd() / "glossary.txt", HOME / "glossary.txt"]
        gl_paths = [] if a.no_glossary else list(dict.fromkeys(p.resolve() for p in gl_paths if p.exists()))
        rules = load_glossary(gl_paths)
        n_gl = 0
        for _ in range(3):  # rules can chain ("Lama" -> "Llama", then "Llama 270b" -> "Llama 2 70B")
            words, n = apply_glossary(words, rules)
            n_gl += n
            if not n:
                break
        words = tidy(words)
        if turns:
            assign_speakers(words, turns)
        sents = sentences(words)
        if len(source.get("chapters") or []) >= 2 and not a.no_chapters:
            secs = sections_from_chapters(sents, source["chapters"], a.section_target, a.section_min, a.section_max)
        else:
            secs = sections(sents, a.section_target, a.section_min, a.section_max)
        low = [{"word": w["word"], "at": hms(w["start"], source["duration"] >= 3600), "p": round(w["p"], 2)}
               for w in words if w["p"] < LOW_P]
        return words, secs, {"words_raw": n_raw, "fillers_removed": n_fill, "stutter_words_removed": n_stut,
                             "glossary_replacements": n_gl, "glossary_files": [str(p) for p in gl_paths],
                             "dropped_suspect_segments": dropped, "suspect_segments_kept": suspect_mid,
                             "low_confidence_words": low[:100], "low_confidence_count": len(low)}

    words, secs, cleanup = timer.step("cleanup+sections", post)
    prev = out_dir / "source.json"  # cached steps keep the timing from the run that actually did them
    timings = json.loads(prev.read_text()).get("timings_seconds", {}) if prev.exists() else {}
    timings = {k: v for k, v in timings.items() if k != "total"}
    timings.update(timer.t)
    timings["total"] = round(sum(v for k, v in timings.items() if k != "total"), 1)
    source.update({
        "model": model.stem.replace("ggml-", ""), "language": a.lang, "speaker_labels": bool(turns),
        "speaker_count": len({t["speaker"] for t in turns}) if turns else 0,
        "created_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "word_count": len(words), "section_count": len(secs), "cleanup": cleanup,
        "timings_seconds": timings,
    })
    write_outputs(out_dir, source, words, secs)
    for d in cleanup["dropped_suspect_segments"]:
        log(f"  dropped suspect segment at {hms(d['start'])}: \"{d['text']}\" (p={d['min_p']})")
    sentence_ends = sum(1 for w in words if SENT_END.search(w["word"]))
    if len(words) > 200 and sentence_ends < len(words) / 60:
        log(f"  WARNING: almost no punctuation ({sentence_ends} sentence ends in {len(words)} words); sections and "
            "quotes will suffer. Rerun with --force and a different --prompt.")
    for d in cleanup["suspect_segments_kept"]:
        log(f"  suspect but kept (isolated, p={d['min_p']}) at {hms(d['start'])}: \"{d['text'][:60]}\"")
    if cleanup["low_confidence_count"]:
        sample = ", ".join(f"{w['word']}@{w['at']}" for w in cleanup["low_confidence_words"][:8])
        log(f"  low-confidence words: {cleanup['low_confidence_count']} (see source.json), e.g. {sample}")
    log(f"  done in {timer.total()}s (whole pipeline {timings['total']}s): {len(words)} words, {len(secs)} sections, {hms(source['duration'])} of audio")
    print(out_dir)


if __name__ == "__main__":
    main()
