JS = r"""
<script>
(function () {
  var paras = Array.prototype.slice.call(document.querySelectorAll('.para'));
  var starts = paras.map(function (p) { return +p.dataset.t; });
  var player = null, playerKind = null, follow = document.getElementById('follow');
  var toast = document.getElementById('toast'); var toastTimer;
  function say(msg) { toast.textContent = msg; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 1600); }
  function fmt(s) { s = Math.round(s); var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; var mm = (h ? String(m).padStart(2, '0') : String(m).padStart(2, '0')) + ':' + String(x).padStart(2, '0'); return h ? h + ':' + mm : mm; }

  // Player: YouTube iframe via postMessage (no external script), or a local <audio>.
  var yt = document.getElementById('yt'); var audio = document.getElementById('audio');
  if (yt) {
    playerKind = 'yt'; player = yt;
    yt.addEventListener('load', function () { yt.contentWindow.postMessage(JSON.stringify({event: 'listening', id: 1, channel: 'widget'}), '*'); });
    window.addEventListener('message', function (e) {
      if (typeof e.data !== 'string') return; var d; try { d = JSON.parse(e.data); } catch (_) { return; }
      if (d.event === 'infoDelivery' && d.info && typeof d.info.currentTime === 'number') tick(d.info.currentTime);
    });
  } else if (audio) { playerKind = 'audio'; player = audio; audio.addEventListener('timeupdate', function () { tick(audio.currentTime); }); }
  function seek(t) {
    if (playerKind === 'yt') { yt.contentWindow.postMessage(JSON.stringify({event: 'command', func: 'seekTo', args: [t, true]}), '*'); yt.contentWindow.postMessage(JSON.stringify({event: 'command', func: 'playVideo', args: []}), '*'); }
    else if (playerKind === 'audio') { audio.currentTime = t; audio.play().catch(function () {}); }
    light(t, true);
  }
  var lastIdx = -1;
  function idxFor(t) { var i = 0; while (i + 1 < starts.length && starts[i + 1] <= t) i++; return starts.length && starts[0] <= t ? i : -1; }
  function light(t, force) {
    var i = idxFor(t); if (i === lastIdx && !force) return;
    if (lastIdx >= 0) paras[lastIdx].classList.remove('now');
    lastIdx = i; if (i < 0) return; paras[i].classList.add('now');
    if (follow && follow.checked || force) paras[i].scrollIntoView({block: 'center', behavior: 'smooth'});
  }
  function tick(t) { light(t, false); }

  // Timestamp links seek when a player exists; otherwise they are plain links (YouTube at &t=, or #t-N).
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a.ts'); if (!a) return;
    var t = +a.dataset.t;
    if (player) { e.preventDefault(); seek(t); }
    else if (a.getAttribute('href').charAt(0) === '#') { e.preventDefault(); var el = document.getElementById('t-' + t) || paras[Math.max(0, idxFor(t))]; if (el) { light(t, true); el.scrollIntoView({block: 'center'}); } }
  });
  // Deep link: #t-305 or #s-3
  var h = location.hash.slice(1), m = /^t-(\d+)$/.exec(h);
  if (m) { setTimeout(function () { light(+m[1], true); }, 50); }

  // Search: hide paragraphs without a hit, mark the hits.
  var q = document.getElementById('q'), count = document.getElementById('count');
  var texts = paras.map(function (p) { return p.querySelector('.txt'); });
  var originals = texts.map(function (s) { return s.textContent; });
  function escRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
  function search() {
    var v = q.value.trim(), re = v.length > 1 ? new RegExp(escRe(v), 'ig') : null, n = 0;
    texts.forEach(function (s, i) {
      var hit = re && re.test(originals[i]); re && (re.lastIndex = 0);
      paras[i].hidden = !!re && !hit; paras[i].classList.toggle('hit', !!hit);
      if (re && hit) { n++; s.innerHTML = originals[i].replace(/[&<>]/g, function (c) { return {'&': '&amp;', '<': '&lt;', '>': '&gt;'}[c]; }).replace(re, function (x) { return '<mark>' + x + '</mark>'; }); }
      else if (s.innerHTML !== originals[i]) s.textContent = originals[i];
    });
    document.querySelectorAll('.transcript section').forEach(function (sec) { sec.hidden = !!re && !sec.querySelector('.para:not([hidden])'); });
    count.textContent = re ? n + ' of ' + paras.length + ' paragraphs' : paras.length + ' paragraphs';
  }
  if (q) { q.addEventListener('input', search); search(); }

  // Copy: the selection (with its timestamp link and the folder) or the whole notes file as markdown.
  var SRC = window.DISTILL;
  function copy(text, label) {
    function fallback() { var ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); say(label); } catch (_) { say('Copy failed; select and copy by hand'); } ta.remove(); }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(function () { say(label); }, fallback); else fallback();
  }
  function stampFor(node) { var p = node && node.nodeType === 1 ? node : node && node.parentElement; var para = p && p.closest ? p.closest('.para') : null; return para ? +para.dataset.t : null; }
  document.getElementById('copy-sel').addEventListener('click', function () {
    var sel = window.getSelection(); var text = sel ? String(sel).trim() : '';
    if (!text) { say('Select some text first'); return; }
    var t = stampFor(sel.anchorNode); var where = t === null ? '' : ' [' + fmt(t) + '](' + (SRC.url ? SRC.url + '&t=' + t : '#t-' + t) + ')';
    copy('> "' + text + '"' + where + '\n\nFrom ' + SRC.title + ' (' + SRC.folder + ')\n\nQuestion: ', 'Copied with timestamp. Paste into Claude Code.');
  });
  var cn = document.getElementById('copy-notes'); if (cn) cn.addEventListener('click', function () { copy(SRC.notes, 'Cliff notes copied as markdown'); });
})();
</script>
"""


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("folder")
    ap.add_argument("--standalone", action="store_true", help="complete HTML document with an embedded player")
    ap.add_argument("--open", action="store_true", help="imply --standalone and open the page")
    ap.add_argument("--out", help="output path (default <folder>/index.html)")
    a = ap.parse_args()
    standalone = a.standalone or a.open
    folder = find_transcript_dir(a.folder)
    data = load_transcript(folder)
    src = data.get("source") or {}
    title = src.get("title") or data.get("title") or folder.name
    url = src.get("url")
    vid = youtube_id(url)
    url_base = f"https://www.youtube.com/watch?v={vid}" if vid else None
    duration = float(src.get("duration") or data.get("duration") or 0)
    hours = duration >= 3600
    notes_md = (folder / "cliffnotes.md").read_text() if (folder / "cliffnotes.md").exists() else ""
    transcript_md = (folder / "transcript.md").read_text()
    # drop the transcript's own title/meta lines; the page has its own header
    body_md = transcript_md.split("\n## ", 1)
    transcript_md = "## " + body_md[1] if len(body_md) == 2 else transcript_md
    # notes: drop the H1 and the source line, which the page header already shows
    notes_lines = [ln for ln in notes_md.splitlines() if not ln.startswith("# ")]
    if notes_lines and notes_lines[0].strip() == "":
        notes_lines = notes_lines[1:]
    if notes_lines and ("·" in notes_lines[0] or "http" in notes_lines[0]) and not notes_lines[0].startswith(("#", "-", ">")):
        notes_lines = notes_lines[1:]
    notes_html = md_to_html("\n".join(notes_lines), url_base) if notes_md else \
        "<p>No cliff notes yet. Run the cliffnotes skill on this folder.</p>"
    t_html, paras = transcript_html(transcript_md, url_base, hours)

    meta = [f"<span>{hms(duration, hours)}</span>", f"<span>{len(data['words']):,} words</span>",
            f"<span>{len(paras)} paragraphs</span>", f"<span>{esc(src.get('model', 'whisper'))}</span>", "<span>no speaker labels</span>"]
    if url:
        meta.insert(0, f'<a href="{esc(url)}" target="_blank" rel="noopener">{esc(src.get("uploader") or "source")} ↗</a>')
    elif src.get("path"):
        meta.insert(0, f"<span>{esc(Path(src['path']).name)}</span>")

    player_html = ""
    if standalone and vid:
        player_html = f'<div class="player"><iframe id="yt" src="https://www.youtube.com/embed/{vid}?enablejsapi=1&rel=0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="{esc(title)}"></iframe></div>'
    elif standalone:
        media = sorted((folder / "media").glob("audio.*")) if (folder / "media").exists() else []
        src_file = media[0] if media else (folder / "audio.wav" if (folder / "audio.wav").exists() else None)
        if src_file:
            player_html = f'<div class="player"><audio id="audio" controls preload="metadata" src="{esc(src_file.relative_to(folder).as_posix())}"></audio></div>'
    follow_html = '<label><input type="checkbox" id="follow" checked> Follow playback</label>' if player_html else ""

    payload = json.dumps({"title": title, "url": url_base, "folder": str(folder), "notes": notes_md}, ensure_ascii=False)
    payload = payload.replace("</", "<\\/")
    page = f"""<title>{esc(title)}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@400;600&family=IBM+Plex+Mono:wght@400;600&display=swap">
{CSS}
<header class="top">
  <h1>{esc(title)}</h1>
  <div class="meta">{' '.join(meta)}</div>
</header>
{player_html}
<div class="wrap">
  <aside class="notes" id="notes">
    {notes_html}
    {'<p><button id="copy-notes">Copy notes as markdown</button></p>' if notes_md else ''}
  </aside>
  <main class="transcript">
    <div class="toolbar">
      <input type="search" id="q" placeholder="Search the transcript" aria-label="Search the transcript">
      <span class="count" id="count"></span>
      {follow_html}
      <button class="primary" id="copy-sel" title="Copy the selected text as a quote with its timestamp, ready to paste into Claude Code">Copy selection for Claude</button>
    </div>
    {t_html}
  </main>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>window.DISTILL = {payload};</script>
{JS}
"""
    if standalone:
        page = f'<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n{page}</head><body></body></html>'
        # move body content: everything after </style>... simpler: browsers accept content before <body>; but be tidy:
        head, rest = page.split("</style>\n", 1)
        rest, tail = rest.rsplit("</head><body></body></html>", 1)
        page = head + "</style>\n</head><body>\n" + rest + "\n</body></html>\n"
    out = Path(a.out) if a.out else folder / ("index.html" if not standalone else "local.html")
    out.write_text(page)
    print(out)
    if a.open:
        subprocess.run(["open", str(out)])


if __name__ == "__main__":
    main()
