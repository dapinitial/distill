#!/usr/bin/env bash
# distill setup: install yt-dlp, fetch the Whisper model, prove it loads on the GPU.
# Idempotent. Run from anywhere once direnv has loaded .envrc (or set DISTILL_MODELS yourself).
set -euo pipefail

MODELS="${DISTILL_MODELS:-$(cd "$(dirname "$0")/.." && pwd)/models}"
MODEL_NAME="ggml-large-v3-turbo.bin"
MODEL="${DISTILL_MODEL:-$MODELS/$MODEL_NAME}"
URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$MODEL_NAME"
EXPECTED_SHA1="4af2b29d7ec73d781377bfd1758ca957a807e941"   # published in whisper.cpp/models/download-ggml-model.sh

say() { printf '\033[1m%s\033[0m\n' "$*"; }

if [[ "${1:-}" == "--mcp" ]]; then
  say "MCP server: the mcp SDK in .venv"
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  [[ -x "$ROOT/.venv/bin/python" ]] || python3 -m venv "$ROOT/.venv"
  "$ROOT/.venv/bin/python" -c "import mcp" 2>/dev/null || "$ROOT/.venv/bin/pip" install -q mcp
  "$ROOT/bin/distill-mcp" --check | head -1
  cat <<EOF

Claude Desktop: add this to ~/Library/Application Support/Claude/claude_desktop_config.json
  "mcpServers": { "distill": { "command": "$ROOT/bin/distill-mcp",
                               "env": { "DISTILL_OUT": "${DISTILL_OUT:-$ROOT/out}" } } }
Claude Code (another project, without the skills):
  claude mcp add distill -- $ROOT/bin/distill-mcp
EOF
  exit 0
fi

if [[ "${1:-}" == "--speakers" ]]; then
  say "Speaker labels: sherpa-onnx in .venv + two ONNX models"
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  brew list --versions cmake >/dev/null 2>&1 || brew install cmake
  [[ -x "$ROOT/.venv/bin/python" ]] || python3 -m venv "$ROOT/.venv"
  "$ROOT/.venv/bin/python" -c "import sherpa_onnx" 2>/dev/null || \
    SHERPA_ONNX_MAKE_ARGS="-j$(sysctl -n hw.ncpu)" "$ROOT/.venv/bin/pip" install -q sherpa-onnx numpy
  mkdir -p "$MODELS"
  if [[ ! -f "$MODELS/sherpa-onnx-pyannote-segmentation-3-0/model.onnx" ]]; then
    curl -sL --fail -o "$MODELS/seg.tar.bz2" "https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-segmentation-models/sherpa-onnx-pyannote-segmentation-3-0.tar.bz2"
    tar xjf "$MODELS/seg.tar.bz2" -C "$MODELS" && rm "$MODELS/seg.tar.bz2"
  fi
  [[ -f "$MODELS/nemo_en_titanet_small.onnx" ]] || \
    curl -sL --fail -o "$MODELS/nemo_en_titanet_small.onnx" "https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/nemo_en_titanet_small.onnx"
  "$ROOT/.venv/bin/python" -c "import sherpa_onnx; print('  ok   sherpa-onnx', sherpa_onnx.__version__)"
  echo "  ok   models in $MODELS"
  exit 0
fi

say "1/3 Homebrew tools"
for f in ffmpeg whisper.cpp yt-dlp; do
  if brew list --versions "$f" >/dev/null 2>&1; then
    echo "  ok   $f $(brew list --versions "$f" | awk '{print $2}')"
  else
    echo "  ...  installing $f"; brew install "$f"
  fi
done

say "2/3 Whisper model → $MODEL"
mkdir -p "$(dirname "$MODEL")"
if [[ -f "$MODEL" ]]; then
  echo "  ok   already present ($(du -h "$MODEL" | cut -f1))"
else
  curl -L --fail --progress-bar -o "$MODEL.part" "$URL"
  mv "$MODEL.part" "$MODEL"
fi
actual="$(shasum -a 1 "$MODEL" | cut -d' ' -f1)"
if [[ "$actual" != "$EXPECTED_SHA1" ]]; then
  echo "  !!   sha1 mismatch: $actual (expected $EXPECTED_SHA1). Delete the file and rerun." >&2; exit 1
fi
echo "  ok   sha1 $actual, $(stat -f%z "$MODEL") bytes"

say "3/3 Load test (should say 'use gpu = 1' and name your GPU)"
sample="$(brew --prefix whisper.cpp)/share/whisper.cpp/jfk.wav"
log="$(mktemp)"
whisper-cli -m "$MODEL" -f "$sample" >"$log" 2>&1 || { cat "$log"; exit 1; }
grep -E 'GPU name|use gpu|total time' "$log" | sed 's/^/  /'
grep -q 'use gpu    = 1' "$log" && echo "  ok   Metal" || echo "  !!   GPU not used; check whisper.cpp build" >&2
rm -f "$log"
