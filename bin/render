#!/usr/bin/env python3
"""render: a transcript folder -> one self-contained HTML page (notes beside the transcript).

  render <transcript folder> [--standalone] [--open]

Default output is an Artifact-ready fragment (no <html>/<head>/<body>; the Artifact tool wraps
it), written to <folder>/index.html. --standalone writes a complete document with an embedded
player (YouTube, or the local audio file) so timestamps seek and the spoken paragraph lights up;
--open opens that in the default browser. Every timestamp is also a plain link, so the page works
with no player at all.
"""
from __future__ import annotations

import argparse
import html
import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from distill_common import find_transcript_dir, hms, load_transcript, parse_hms, youtube_id  # noqa: E402

TS = r"\d{1,2}:\d{2}(?::\d{2})?"
LINK_TS = re.compile(rf"\[({TS})(?:\s*[-–]\s*({TS}))?\]\((https?://[^)\s]+)\)")
BARE_TS = re.compile(rf"\[({TS})(?:\s*[-–]\s*({TS}))?\](?!\()")
INLINE_LINK = re.compile(r"\[([^\]]+)\]\((https?://[^)\s]+)\)")


def esc(s: str) -> str:
    return html.escape(s, quote=True)


def ts_anchor(label: str, secs: float, url_base: str | None, end: str | None = None) -> str:
    text = label + (f"–{end}" if end else "")
    href = f"{url_base}&t={int(secs)}" if url_base else f"#t-{int(secs)}"
    target = ' target="_blank" rel="noopener"' if url_base else ""
    return f'<a class="ts" data-t="{int(secs)}" href="{esc(href)}"{target}>{esc(text)}</a>'


def inline(md: str, url_base: str | None) -> str:
    """Inline markdown: timestamps first (they become seek links), then links, bold, code."""
    out, pos = [], 0
    for m in re.finditer(rf"{LINK_TS.pattern}|{BARE_TS.pattern}|{INLINE_LINK.pattern}|`[^`]+`|\*\*[^*]+\*\*", md):
        out.append(esc(md[pos:m.start()]))
        s = m.group(0)
        if lm := LINK_TS.fullmatch(s):
            out.append(ts_anchor(lm.group(1), parse_hms(lm.group(1)), url_base, lm.group(2)))
        elif bm := BARE_TS.fullmatch(s):
            out.append(ts_anchor(bm.group(1), parse_hms(bm.group(1)), url_base, bm.group(2)))
        elif im := INLINE_LINK.fullmatch(s):
            out.append(f'<a href="{esc(im.group(2))}" target="_blank" rel="noopener">{esc(im.group(1))}</a>')
        elif s.startswith("`"):
            out.append(f"<code>{esc(s[1:-1])}</code>")
        else:
            out.append(f"<strong>{esc(s[2:-2])}</strong>")
        pos = m.end()
    out.append(esc(md[pos:]))
    return "".join(out)


def md_to_html(md: str, url_base: str | None) -> str:
    """Enough markdown for cliffnotes.md: headings, nested bullets, blockquotes, hr, paragraphs."""
    out: list[str] = []
    stack: list[int] = []  # open <ul> indents
    para: list[str] = []

    def flush_para():
        if para:
            out.append(f"<p>{inline(' '.join(para), url_base)}</p>")
            para.clear()

    def close_lists(to_indent: int = -1):
        while stack and stack[-1] > to_indent:
            out.append("</li></ul>")
            stack.pop()

    for raw in md.splitlines():
        line = raw.rstrip()
        if not line.strip():
            flush_para(); close_lists(); continue
        if m := re.match(r"^(#{1,6})\s+(.*)$", line):
            flush_para(); close_lists()
            lvl = max(2, min(len(m.group(1)), 4))  # the page's own h1 is the title
            text = m.group(2)
            if lvl == 2:
                out.append(f'<h2 id="{esc(slug_id(text))}">{inline(text, url_base)}</h2>')
            else:
                out.append(f"<h{lvl}>{inline(text, url_base)}</h{lvl}>")
            continue
        if re.match(r"^-{3,}$", line):
            flush_para(); close_lists(); out.append("<hr>"); continue
        if m := re.match(r"^>\s?(.*)$", line):
            flush_para(); close_lists()
            out.append(f"<blockquote>{inline(m.group(1), url_base)}</blockquote>")
            continue
        if m := re.match(r"^(\s*)[-*]\s+(.*)$", line):
            flush_para()
            indent = len(m.group(1))
            if not stack or indent > stack[-1]:
                out.append("<ul>"); stack.append(indent)
            else:
                close_lists(indent)
                if not stack or stack[-1] != indent:
                    out.append("<ul>"); stack.append(indent)
                else:
                    out.append("</li>")
            out.append(f"<li>{inline(m.group(2), url_base)}")
            continue
        para.append(line.strip())
    flush_para(); close_lists()
    return "\n".join(out)


def slug_id(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "section"


def transcript_html(md: str, url_base: str | None, hours: bool) -> tuple[str, list[dict]]:
    """Sections and paragraphs from transcript.md. Returns (html, paragraph starts)."""
    out: list[str] = []
    paras: list[dict] = []
    open_sec = False
    for line in md.splitlines():
        if m := re.match(rf"^## (\d+)\. \[({TS})[-–]({TS})\]", line):
            if open_sec:
                out.append("</section>")
            n, a, b = m.group(1), m.group(2), m.group(3)
            out.append(f'<section id="s-{n}"><h3><span class="n">{n}</span> {ts_anchor(a, parse_hms(a), url_base)} – '
                       f'{ts_anchor(b, parse_hms(b), url_base)} <span class="dur">{hms(parse_hms(b) - parse_hms(a))}</span></h3>')
            open_sec = True
        elif m := re.match(rf"^\[({TS})\] (.*)$", line):
            t = parse_hms(m.group(1))
            paras.append({"t": t})
            out.append(f'<p class="para" id="t-{int(t)}" data-t="{int(t)}">{ts_anchor(m.group(1), t, url_base)} '
                       f'<span class="txt">{esc(m.group(2))}</span></p>')
    if open_sec:
        out.append("</section>")
    return "\n".join(out), paras


