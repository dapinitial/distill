#!/usr/bin/env python3
"""library: index every transcript folder under $DISTILL_OUT.

  library [--out DIR] [--open] [--serve [PORT]]

Writes <out>/index.md (for agents) and <out>/index.html (for people): title, date, duration,
the point from the cliff notes, and links to the folder, the page and the source. Also writes
<out>/library.json (the same entries, for fetching) and <out>/toc.html (a compact table of contents
that links only to published pages and sources; publish it as an Artifact with library.json beside it).
--serve puts the folder on localhost with CORS open so any page can iframe toc.html or fetch library.json.
"""
from __future__ import annotations

import argparse
import html
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from distill_common import hms  # noqa: E402

HOME = Path(os.environ.get("DISTILL_HOME", Path(__file__).resolve().parent.parent))


def the_point(notes: str) -> str:
    m = re.search(r"^## The point\s*\n(.+?)(?:\n## |\Z)", notes, re.S | re.M)
    return re.sub(r"\s+", " ", m.group(1)).strip() if m else ""


def entries(root: Path) -> list[dict]:
    out = []
    for src_path in sorted(root.glob("*/source.json")):
        folder = src_path.parent
        src = json.loads(src_path.read_text())
        notes_path = folder / "cliffnotes.md"
        notes = notes_path.read_text() if notes_path.exists() else ""
        out.append({
            "slug": folder.name, "title": src.get("title") or folder.name, "url": src.get("url"),
            "uploader": src.get("uploader"), "duration": float(src.get("duration") or 0),
            "created": (src.get("created_at") or "")[:10], "words": src.get("word_count", 0),
            "point": the_point(notes), "has_notes": bool(notes), "has_page": (folder / "index.html").exists(),
            "artifact": json.loads((folder / "artifact.json").read_text()).get("url") if (folder / "artifact.json").exists() else None,
        })
    out.sort(key=lambda e: e["created"], reverse=True)
    return out


def write_md(root: Path, items: list[dict]) -> None:
    lines = ["# distill library", "", f"{len(items)} transcripts under `{root}`. Newest first.", ""]
    for e in items:
        head = f"## {e['title']}"
        meta = [e["created"], hms(e["duration"]), f"{e['words']:,} words"]
        if e["uploader"]:
            meta.insert(1, e["uploader"])
        links = [f"[folder]({e['slug']}/)"]
        if e["has_notes"]:
            links.append(f"[cliff notes]({e['slug']}/cliffnotes.md)")
        if e["url"]:
            links.append(f"[source]({e['url']})")
        if e["artifact"]:
            links.append(f"[artifact]({e['artifact']})")
        lines += [head, "", " · ".join(meta) + " · " + " · ".join(links), ""]
        lines += [e["point"] or "_No cliff notes yet._", ""]
    (root / "index.md").write_text("\n".join(lines))


def write_html(root: Path, items: list[dict]) -> None:
    esc = lambda s: html.escape(str(s), quote=True)  # noqa: E731
    cards = []
    for e in items:
        links = [f'<a href="{esc(e["slug"])}/local.html">page</a>' if (root / e["slug"] / "local.html").exists() else ""]
        if e["has_notes"]:
            links.append(f'<a href="{esc(e["slug"])}/cliffnotes.md">notes</a>')
        if e["url"]:
            links.append(f'<a href="{esc(e["url"])}" target="_blank" rel="noopener">source ↗</a>')
        if e["artifact"]:
            links.append(f'<a href="{esc(e["artifact"])}" target="_blank" rel="noopener">artifact ↗</a>')
        cards.append(f'''<article>
  <h2>{esc(e["title"])}</h2>
  <div class="meta"><span>{esc(e["created"])}</span>{f'<span>{esc(e["uploader"])}</span>' if e["uploader"] else ""}<span>{hms(e["duration"])}</span><span>{e["words"]:,} words</span></div>
  <p>{esc(e["point"]) if e["point"] else "<em>No cliff notes yet.</em>"}</p>
  <div class="links">{" ".join(l for l in links if l)}</div>
</article>''')
    page = f"""<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>distill library</title>
<style>
:root {{ --bg:#f5f6f8; --panel:#fff; --fg:#1c2029; --muted:#6a7282; --line:#dfe3ea; --accent:#0d6b70 }}
@media (prefers-color-scheme: dark) {{ :root {{ --bg:#13161d; --panel:#1b1f28; --fg:#e4e7ee; --muted:#949caf; --line:#2b313d; --accent:#5cc8cc; color-scheme: dark }} }}
body {{ margin:0; background:var(--bg); color:var(--fg); font:16px/1.5 "IBM Plex Sans", -apple-system, Helvetica, Arial, sans-serif; padding: 24px max(16px, 4vw) 48px }}
h1 {{ font: 600 1.6rem/1.2 "IBM Plex Serif", Georgia, serif; margin: 0 0 4px }} .sub {{ color: var(--muted); margin: 0 0 24px }}
.grid {{ display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px }}
article {{ background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; min-width: 0 }}
article h2 {{ font: 600 1.05rem/1.3 inherit; margin: 0 0 6px; text-wrap: balance }}
.meta {{ color: var(--muted); font-size: .85rem; display:flex; flex-wrap:wrap; gap: 4px 14px; margin-bottom: 8px }}
article p {{ margin: 0 0 10px; font-size: .95rem }} .links a {{ color: var(--accent); margin-right: 12px; font-size: .9rem }}
</style></head><body>
<h1>distill library</h1><p class="sub">{len(items)} transcripts · newest first</p>
<div class="grid">{''.join(cards)}</div>
</body></html>
"""
    (root / "index.html").write_text(page)


def write_json(root: Path, items: list[dict]) -> None:
    """library.json: the same entries for anything that fetches rather than reads."""
    keys = ("slug", "title", "uploader", "url", "artifact", "created", "duration", "words", "point")
    doc = {"generated": __import__("datetime").date.today().isoformat(), "count": len(items),
           "entries": [{k: e[k] for k in keys} for e in items]}
    (root / "library.json").write_text(json.dumps(doc, ensure_ascii=False, indent=1) + "\n")


def write_toc(root: Path, items: list[dict]) -> None:
    """toc.html: a compact table of contents meant to be published as its own Artifact.

    Links only to things that resolve from anywhere (the published pages and the sources), never to
    local files. Narrow-friendly so it also works inside an iframe or a sidebar. library.json is
    published beside it for anything that would rather fetch than read.
    """
    esc = lambda s: html.escape(str(s), quote=True)  # noqa: E731
    rows = []
    for e in items:
        title = f'<a href="{esc(e["artifact"])}" target="_blank" rel="noopener">{esc(e["title"])}</a>' if e["artifact"] else esc(e["title"])
        meta = [hms(e["duration"]), f"{e['words']:,} words", e["created"]]
        if e["uploader"]:
            meta.insert(0, esc(e["uploader"]))
        links = []
        if e["artifact"]:
            links.append(f'<a href="{esc(e["artifact"])}" target="_blank" rel="noopener">notes + transcript</a>')
        if e["url"]:
            links.append(f'<a href="{esc(e["url"])}" target="_blank" rel="noopener">source</a>')
        state = "" if e["artifact"] else ' <span class="tag">not published</span>'
        point = esc(e["point"]) if e["point"] else '<em>No cliff notes yet.</em>'
        ring = ('<svg class="mini" viewBox="0 0 20 20" aria-hidden="true"><circle class="track" cx="10" cy="10" r="8"/>'
                '<circle class="bar" cx="10" cy="10" r="8" pathLength="100" stroke-dasharray="0 100"/></svg>')
        rows.append(f'''<li data-slug="{esc(e["slug"])}" data-q="{esc((e["title"] + " " + (e["uploader"] or "") + " " + e["point"]).lower())}">
  <h2>{ring}{title}{state}<span class="stamp" hidden>READ</span></h2>
  <div class="meta">{" · ".join(meta)}<span class="readat"></span></div>
  <p>{point}</p>
  <div class="links">{" · ".join(links)}<button class="mark" type="button">Mark read</button></div>
</li>''')
    total = sum(e["duration"] for e in items)
    toc_data = json.dumps({e["slug"]: {"d": round(e["duration"]), "t": e["title"]} for e in items}, ensure_ascii=False).replace("</", "<\\/")
    page = f"""<title>distill library</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@600&family=IBM+Plex+Mono:wght@400&display=swap">
<style>
/* Layout: one narrow column, a table of contents that reads the same at 360px in an iframe as on a desktop tab. */
:root {{ --bg:#f5f6f8; --panel:#ffffff; --fg:#1c2029; --muted:#6a7282; --line:#dfe3ea; --accent:#0d6b70;
  --display:"IBM Plex Serif", Georgia, serif; --body:"IBM Plex Sans", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; --mono:"IBM Plex Mono", ui-monospace, Menlo, monospace }}
@media (prefers-color-scheme: dark) {{ :root:not([data-theme="light"]) {{ --bg:#13161d; --panel:#1b1f28; --fg:#e4e7ee; --muted:#949caf; --line:#2b313d; --accent:#5cc8cc; color-scheme: dark }} }}
:root[data-theme="dark"] {{ --bg:#13161d; --panel:#1b1f28; --fg:#e4e7ee; --muted:#949caf; --line:#2b313d; --accent:#5cc8cc; color-scheme: dark }}
*, *::before, *::after {{ box-sizing: border-box }}
body {{ margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 var(--body); padding-block: 0 40px;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)) }}
a {{ color: var(--accent) }}
.wrap {{ max-width: 720px; margin: 0 auto }}
header {{ padding-block: 20px 12px; border-bottom: 1px solid var(--line); display:flex; flex-wrap:wrap; gap: 6px 16px; align-items: baseline }}
h1 {{ font: 600 1.25rem/1.2 var(--display); margin: 0 }}
.sub {{ color: var(--muted); font-size: .85rem; font-variant-numeric: tabular-nums }}
.tools {{ display:flex; gap:8px; align-items:center; padding-block: 12px; position: sticky; top: env(safe-area-inset-top, 0px); background: var(--bg); z-index: 2 }}
input[type=search] {{ flex:1 1 160px; min-width:0; font: inherit; padding: 6px 10px; border:1px solid var(--line); border-radius:6px; background:var(--panel); color:var(--fg) }}
input:focus-visible, a:focus-visible {{ outline: 2px solid var(--accent); outline-offset: 2px }}
.count {{ color: var(--muted); font-size: .85rem; font-variant-numeric: tabular-nums; white-space: nowrap }}
ol {{ list-style: none; margin: 0; padding: 0; display: grid; gap: 0 }}
li {{ padding-block: 10px; border-bottom: 1px solid var(--line); min-width: 0 }}
li h2 {{ font: 600 1rem/1.3 var(--body); margin: 0 0 2px; text-wrap: balance }}
li h2 a {{ color: inherit; text-decoration: none }} li h2 a:hover {{ color: var(--accent); text-decoration: underline }}
.meta {{ color: var(--muted); font-size: .8rem; font-family: var(--mono); margin-bottom: 6px }}
/* Rows stay one line each: title and meta. The summary shows on hover, keyboard focus, or a tap on the row. */
li p {{ margin: 6px 0; max-width: 65ch; display: none }}
li:hover p, li:focus-within p, li.open p {{ display: block }}
li .meta {{ margin-bottom: 0 }} li .links {{ margin-top: 4px }}
.links {{ font-size: .85rem }} .links a {{ margin-right: 2px }}
.tag {{ font: 500 .7rem/1 var(--body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 3px 5px; vertical-align: middle; margin-left: 6px }}
footer {{ color: var(--muted); font-size: .8rem; padding-top: 16px }} footer code {{ font-family: var(--mono) }}
/* Reading progress, kept in the page's database: a one-pixel line for the whole list, a small ring per talk, a stamp when done. */
.line {{ height: 1px; background: var(--line); position: relative; margin-top: -1px }} .line i {{ position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--accent); transition: width .4s ease }}
.prog {{ display: none; font-variant-numeric: tabular-nums }} .has-db .prog {{ display: inline }}
.mini {{ width: 18px; height: 18px; vertical-align: -3px; margin-right: 8px; display: none }} .has-db .mini {{ display: inline-block }}
.mini circle {{ fill: none; stroke-width: 2.5; stroke-linecap: round }} .mini .track {{ stroke: var(--line) }} .mini .bar {{ stroke: var(--accent); transform: rotate(-90deg); transform-origin: 50% 50%; transition: stroke-dasharray .4s ease }}
.stamp {{ font: 600 .65rem/1 var(--mono); letter-spacing: .1em; color: var(--accent); border: 1.5px solid var(--accent); border-radius: 3px; padding: 3px 5px; vertical-align: middle; margin-left: 8px; transform: rotate(-3deg); display: inline-block }}
li.read {{ order: 1 }} li.read h2 a {{ color: var(--muted) }} li.read .mini .bar {{ stroke: var(--muted) }}
.readat {{ margin-left: 10px }} .readat:empty {{ display: none }}
.has-db .mark {{ display: inline }} .mark {{ display: none; font: inherit; font-size: .8rem; margin-left: 12px; padding: 3px 8px; border: 1px solid var(--line); border-radius: 5px; background: var(--panel); color: var(--muted); cursor: pointer }} .mark:hover {{ color: var(--accent); border-color: var(--accent) }}
.toast {{ position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); background: var(--fg); color: var(--bg); padding: 8px 14px; border-radius: 6px; font-size: .9rem; opacity: 0; transition: opacity .2s; pointer-events: none; max-width: 90vw }} .toast.show {{ opacity: 1 }}
@media (prefers-reduced-motion: reduce) {{ .line i, .mini .bar, .toast {{ transition: none }} }}
</style>
<div class="wrap">
<header><h1>distill library</h1><span class="sub">{len(items)} talks · {hms(total)} of video · updated {esc(__import__("datetime").date.today().isoformat())}<span class="prog" id="prog"></span></span></header>
<div class="line" aria-hidden="true"><i id="line"></i></div>
<div class="tools"><input type="search" id="q" placeholder="Filter by title, speaker or topic" aria-label="Filter the library"><span class="count" id="count"></span></div>
<ol id="list">{''.join(rows)}</ol>
<footer>Each entry opens the published page: cliff notes beside the full transcript, every timestamp a link into the video. Progress rings fill as you read; the page's own "Save progress" and "Mark as read" links report back here. Machine-readable copy: <a href="library.json">library.json</a> next to this page. Transcribed locally with whisper.cpp; nothing but these pages leaves the machine.</footer>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>window.TOC = {toc_data};</script>
<script>
(function () {{
  var q = document.getElementById('q'), items = Array.prototype.slice.call(document.querySelectorAll('#list li')), count = document.getElementById('count');
  function filter() {{ var v = q.value.trim().toLowerCase(), n = 0; items.forEach(function (li) {{ var hit = !v || li.dataset.q.indexOf(v) >= 0; li.hidden = !hit; if (hit) n++; }}); count.textContent = v ? n + ' of ' + items.length : items.length + ' talks'; }}
  q.addEventListener('input', filter); filter();
  document.getElementById('list').addEventListener('click', function (e) {{ if (e.target.closest('a, button')) return; var li = e.target.closest('li'); if (li) li.classList.toggle('open'); }});

  // Reading progress lives in this artifact's database (one document per talk: pct, read, at), so it follows you
  // across devices and the transcript pages can report to it through a hash: #read-<slug> or #at-<slug>-<pct>.
  var toast = document.getElementById('toast'), toastTimer;
  function say(msg) {{ toast.textContent = msg; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(function () {{ toast.classList.remove('show'); }}, 2200); }}
  function hms(s) {{ s = Math.round(s); var h = Math.floor(s / 3600), m = Math.round(s % 3600 / 60); return h ? h + 'h ' + String(m).padStart(2, '0') + 'm' : m + 'm'; }}
  var byslug = {{}}; items.forEach(function (li) {{ byslug[li.dataset.slug] = li; }});
  var state = {{}};
  function render() {{
    var total = 0, done = 0, nread = 0;
    items.forEach(function (li) {{
      var slug = li.dataset.slug, d = (window.TOC[slug] || {{}}).d || 0, s = state[slug] || {{}}, pct = s.read ? 100 : Math.max(0, Math.min(100, s.pct || 0));
      total += d; done += d * pct / 100; if (s.read) nread++;
      li.classList.toggle('read', !!s.read);
      li.querySelector('.mini .bar').setAttribute('stroke-dasharray', pct + ' 100');
      li.querySelector('.stamp').hidden = !s.read;
      li.querySelector('.readat').textContent = s.read && s.at ? 'read ' + s.at.slice(0, 10) : (pct > 0 ? pct + '% read' : '');
      var b = li.querySelector('.mark'); b.textContent = s.read ? 'Mark unread' : 'Mark read';
    }});
    document.getElementById('line').style.width = (total ? done / total * 100 : 0) + '%';
    document.getElementById('prog').textContent = ' · ' + nread + ' of ' + items.length + ' read · ' + hms(Math.max(0, total - done)) + ' left';
  }}
  if (!window.claude || typeof window.claude.use !== 'function') return;
  window.claude.use('db').then(function (db) {{
    if (!db) return;
    document.body.classList.add('has-db');
    var reads = db.collection('reads');
    function mark(slug, pct, read) {{
      if (!byslug[slug]) return Promise.resolve();
      var ref = reads.doc(slug);
      return ref.get().then(function (snap) {{
        var cur = snap.exists ? snap.data() : {{}};
        var next = {{pct: read === null ? Math.max(cur.pct || 0, pct) : (read ? 100 : Math.min(cur.pct || 0, 99)), read: read === null ? !!cur.read : read, at: new Date().toISOString()}};
        if (cur.pct === next.pct && !!cur.read === next.read) return;
        return ref.set(next).then(function () {{ say((next.read ? 'Marked as read: ' : 'Saved ' + next.pct + '%: ') + (window.TOC[slug] || {{}}).t); }});
      }}).catch(function (e) {{ say('Could not save: ' + (e && e.message || e)); }});
    }}
    var h = location.hash.slice(1), m;
    if ((m = /^read-([a-z0-9][a-z0-9-]*)$/.exec(h))) mark(m[1], 100, true);
    else if ((m = /^at-([a-z0-9][a-z0-9-]*)-(\\d{{1,3}})$/.exec(h))) mark(m[1], +m[2], null);
    reads.onSnapshot(function (snap) {{ state = {{}}; snap.docs.forEach(function (d) {{ state[d.id] = d.data() || {{}}; }}); render(); }},
                     function (e) {{ say('Progress is read-only right now: ' + (e && e.message || e)); }});
    document.getElementById('list').addEventListener('click', function (e) {{
      var b = e.target.closest && e.target.closest('.mark'); if (!b) return;
      var slug = b.closest('li').dataset.slug, s = state[slug] || {{}};
      mark(slug, s.read ? 0 : 100, !s.read);
    }});
  }});
}})();
</script>
"""
    (root / "toc.html").write_text(page)


def serve(root: Path, port: int) -> None:
    """Serve the library folder on localhost with CORS open, so any page can iframe toc.html or
    fetch library.json. Private Artifacts cannot be embedded or fetched from outside claude.ai; this is
    the local equivalent. Nothing leaves the machine."""
    import http.server
    import functools

    class H(http.server.SimpleHTTPRequestHandler):
        def end_headers(self):
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "no-store")
            super().end_headers()

        def log_message(self, fmt, *args):  # quiet
            pass

    handler = functools.partial(H, directory=str(root))
    with http.server.ThreadingHTTPServer(("127.0.0.1", port), handler) as srv:
        print(f"serving {root} at http://localhost:{port}/toc.html and /library.json (ctrl-c to stop)")
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--out", default=os.environ.get("DISTILL_OUT", str(HOME / "out")))
    ap.add_argument("--open", action="store_true")
    ap.add_argument("--serve", nargs="?", const=8765, type=int, metavar="PORT",
                    help="after writing, serve the folder on localhost (default port 8765) with CORS open")
    a = ap.parse_args()
    root = Path(a.out).expanduser()
    items = entries(root)
    write_md(root, items)
    write_html(root, items)
    write_json(root, items)
    write_toc(root, items)
    print(f"{root / 'index.md'}\n{root / 'index.html'}\n{root / 'library.json'}\n{root / 'toc.html'}  ({len(items)} transcripts)")
    if a.serve:
        serve(root, a.serve)
    if a.open:
        subprocess.run(["open", str(root / "index.html")])


if __name__ == "__main__":
    main()
