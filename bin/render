#!/usr/bin/env python3
"""render: a transcript folder -> one self-contained HTML page (notes beside the transcript).

  render <transcript folder> [--standalone] [--open]

Default output is an Artifact-ready fragment (no <html>/<head>/<body>; the Artifact tool wraps
it), written to <folder>/index.html. --standalone writes a complete document with an embedded
player (YouTube, or the local audio file) so timestamps seek and the spoken paragraph lights up;
--open opens that in the default browser. Every timestamp is also a plain link, so the page works
with no player at all.
"""
from __future__ import annotations

import argparse
import base64
import html
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from distill_common import find_transcript_dir, hms, load_transcript, parse_hms, youtube_id  # noqa: E402

TS = r"\d{1,2}:\d{2}(?::\d{2})?"
LINK_TS = re.compile(rf"\[({TS})(?:\s*[-–]\s*({TS}))?\]\((https?://[^)\s]+)\)")
BARE_TS = re.compile(rf"\[({TS})(?:\s*[-–]\s*({TS}))?\](?!\()")
INLINE_LINK = re.compile(r"\[([^\]]+)\]\((https?://[^)\s]+)\)")


def esc(s: str) -> str:
    return html.escape(s, quote=True)


def ts_anchor(label: str, secs: float, url_base: str | None, end: str | None = None) -> str:
    text = label + (f"–{end}" if end else "")
    href = f"{url_base}&t={int(secs)}" if url_base else f"#t-{int(secs)}"
    target = ' target="_blank" rel="noopener"' if url_base else ""
    return f'<a class="ts" data-t="{int(secs)}" href="{esc(href)}"{target}>{esc(text)}</a>'


def inline(md: str, url_base: str | None) -> str:
    """Inline markdown: timestamps first (they become seek links), then links, bold, code."""
    out, pos = [], 0
    for m in re.finditer(rf"{LINK_TS.pattern}|{BARE_TS.pattern}|{INLINE_LINK.pattern}|`[^`]+`|\*\*[^*]+\*\*|\*[^*\n]+\*", md):
        out.append(esc(md[pos:m.start()]))
        s = m.group(0)
        if lm := LINK_TS.fullmatch(s):
            out.append(ts_anchor(lm.group(1), parse_hms(lm.group(1)), url_base, lm.group(2)))
        elif bm := BARE_TS.fullmatch(s):
            out.append(ts_anchor(bm.group(1), parse_hms(bm.group(1)), url_base, bm.group(2)))
        elif im := INLINE_LINK.fullmatch(s):
            out.append(f'<a href="{esc(im.group(2))}" target="_blank" rel="noopener">{esc(im.group(1))}</a>')
        elif s.startswith("`"):
            out.append(f"<code>{esc(s[1:-1])}</code>")
        elif s.startswith("**"):
            out.append(f"<strong>{esc(s[2:-2])}</strong>")
        else:
            out.append(f"<em>{esc(s[1:-1])}</em>")
        pos = m.end()
    out.append(esc(md[pos:]))
    return "".join(out)


def md_to_html(md: str, url_base: str | None) -> str:
    """Enough markdown for cliffnotes.md: headings, nested bullets, blockquotes, hr, paragraphs."""
    out: list[str] = []
    stack: list[int] = []  # open <ul> indents
    para: list[str] = []

    def flush_para():
        if para:
            out.append(f"<p>{inline(' '.join(para), url_base)}</p>")
            para.clear()

    def close_lists(to_indent: int = -1):
        while stack and stack[-1] > to_indent:
            out.append("</li></ul>")
            stack.pop()

    for raw in md.splitlines():
        line = raw.rstrip()
        if not line.strip():
            flush_para(); close_lists(); continue
        if m := re.match(r"^(#{1,6})\s+(.*)$", line):
            flush_para(); close_lists()
            lvl = max(2, min(len(m.group(1)), 4))  # the page's own h1 is the title
            text = m.group(2)
            if lvl == 2:
                out.append(f'<h2 id="{esc(slug_id(text))}">{inline(text, url_base)}</h2>')
            else:
                out.append(f"<h{lvl}>{inline(text, url_base)}</h{lvl}>")
            continue
        if re.match(r"^-{3,}$", line):
            flush_para(); close_lists(); out.append("<hr>"); continue
        if m := re.match(r"^>\s?(.*)$", line):
            flush_para(); close_lists()
            out.append(f"<blockquote>{inline(m.group(1), url_base)}</blockquote>")
            continue
        if m := re.match(r"^(\s*)[-*]\s+(.*)$", line):
            flush_para()
            indent = len(m.group(1))
            if not stack or indent > stack[-1]:
                out.append("<ul>"); stack.append(indent)
            else:
                close_lists(indent)
                if not stack or stack[-1] != indent:
                    out.append("<ul>"); stack.append(indent)
                else:
                    out.append("</li>")
            out.append(f"<li>{inline(m.group(2), url_base)}")
            continue
        para.append(line.strip())
    flush_para(); close_lists()
    return "\n".join(out)


def video_file(folder: Path) -> Path | None:
    for pat in ("media/video.*", "*.mp4", "*.mov", "*.mkv", "*.webm"):
        for p in sorted(folder.glob(pat)):
            if p.suffix != ".part" and not p.name.startswith("audio."):
                return p
    src = (folder / "source.json")
    if src.exists():
        path = json.loads(src.read_text()).get("path")
        if path and Path(path).suffix.lower() in (".mp4", ".mov", ".mkv", ".webm", ".m4v") and Path(path).exists():
            return Path(path)
    return None


def grab_frames(video: Path, folder: Path, times: list[float], width: int = 480) -> dict[int, str]:
    """One JPEG per time (cached in <folder>/frames/), returned as data URIs keyed by second."""
    out: dict[int, str] = {}
    fdir = folder / "frames"
    fdir.mkdir(exist_ok=True)
    for t in sorted({int(t) for t in times}):
        jpg = fdir / f"{t:06d}.jpg"
        if not jpg.exists():
            r = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", str(t + 1), "-i", str(video), "-frames:v", "1",
                                "-vf", f"scale={width}:-2", "-q:v", "6", str(jpg)])
            if r.returncode or not jpg.exists():
                continue
        out[t] = "data:image/jpeg;base64," + base64.b64encode(jpg.read_bytes()).decode()
    return out


def slug_id(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "section"


PAGE_WORDS = 2500   # a page of transcript is about this long; talks under PAGE_MIN words stay one page
PAGE_MIN = 4000


def transcript_html(md: str, url_base: str | None, hours: bool, frames: dict[int, str] | None = None) -> tuple[str, list[dict], dict[str, int]]:
    """Sections and paragraphs from transcript.md, grouped into pages for long talks.
    Returns (html, paragraph starts, section number -> page index)."""
    secs: list[dict] = []
    paras: list[dict] = []
    for line in md.splitlines():
        if m := re.match(rf"^## (\d+)\. \[({TS})[-–]({TS})\]\s*(.*)$", line):
            n, a, b, ttl = m.group(1), m.group(2), m.group(3), m.group(4).strip()
            ttl_html = f' <span class="ttl">{esc(ttl)}</span>' if ttl else ""
            out = [f'<section id="s-{n}"><h3><span class="n">{n}</span> {ts_anchor(a, parse_hms(a), url_base)} – '
                   f'{ts_anchor(b, parse_hms(b), url_base)}{ttl_html} <span class="dur">{hms(parse_hms(b) - parse_hms(a))}</span></h3>']
            fr = (frames or {}).get(int(parse_hms(a)))
            if fr:
                out.append(f'<a class="frame" data-t="{int(parse_hms(a))}" href="{esc((url_base + "&t=" + str(int(parse_hms(a)))) if url_base else "#t-" + str(int(parse_hms(a))))}"'
                           f'{" target=_blank rel=noopener" if url_base else ""}><img src="{fr}" alt="frame at {esc(a)}" loading="lazy"></a>')
            secs.append({"n": n, "html": out, "words": 0})
        elif m := re.match(rf"^\[({TS})\] (?:\*\*(Speaker \d+):\*\* )?(.*)$", line):
            t = parse_hms(m.group(1))
            paras.append({"t": t})
            spk = f'<b class="spk">{esc(m.group(2))}</b> ' if m.group(2) else ""
            if not secs:
                secs.append({"n": "0", "html": ["<section>"], "words": 0})
            secs[-1]["html"].append(f'<p class="para" id="t-{int(t)}" data-t="{int(t)}">{ts_anchor(m.group(1), t, url_base)} '
                                    f'{spk}<span class="txt">{esc(m.group(3))}</span></p>')
            secs[-1]["words"] += len(m.group(3).split())
    total = sum(x["words"] for x in secs)
    pages = max(2, round(total / PAGE_WORDS)) if total > PAGE_MIN and len(secs) > 1 else 1
    pages = min(pages, len(secs))
    # Each section goes to the page its midpoint falls on, so pages come out near equal and a section is never split.
    page_of: dict[str, int] = {}
    before = 0
    for x in secs:
        page_of[x["n"]] = min(pages - 1, int((before + x["words"] / 2) / total * pages)) if pages > 1 else 0
        before += x["words"]
    if pages == 1:
        return "\n".join("\n".join(x["html"]) + "\n</section>" for x in secs), paras, {}
    out: list[str] = []
    for k in range(pages):
        group = [x for x in secs if page_of[x["n"]] == k]
        out.append(f'<div class="page" id="p-{k + 1}" data-w="{sum(x["words"] for x in group)}"{"" if k == 0 else " hidden"}>')
        out.extend("\n".join(x["html"]) + "\n</section>" for x in group)
        out.append("</div>")
    return "\n".join(out), paras, page_of


def jump_html(md: str, page_of: dict[str, int] | None = None) -> str:
    """The section jump list: a dropdown in the sticky toolbar showing the current section."""
    secs = [m.groups() for m in re.finditer(rf"^## (\d+)\. \[({TS})[-–]({TS})\]\s*(.*)$", md, re.M)]
    if len(secs) < 2:
        return ""
    items = []
    last = 0
    for n, a, _b, ttl in secs:
        label = esc(ttl.strip()) or f"Section {n}"
        pg = (page_of or {}).get(n, 0)
        head = f'<li class="pg-head">Page {pg + 1}</li>' if page_of and (pg != last or n == secs[0][0]) else ""
        last = pg
        items.append(f'{head}<li><a href="#s-{n}" data-s="{n}"><span class="jn">{n}</span><span class="jl">{label}</span>'
                     f'<span class="jt">{esc(a)}</span></a></li>')
    n0, a0, _, t0 = secs[0]
    return (f'<details class="jump" id="jump"><summary title="Jump to a section">'
            f'<span class="jn" id="jump-n">{n0}</span><span class="jl" id="jump-l">{esc(t0.strip()) or "Section " + n0}</span>'
            f'<span class="jt">of {len(secs)}</span></summary><ol>{"".join(items)}</ol></details>')


def pager_html(md: str, page_of: dict[str, int]) -> tuple[str, str]:
    """Page controls for a paged transcript: a compact one for the toolbar, a fuller one under the page."""
    if not page_of:
        return "", ""
    pages = max(page_of.values()) + 1
    firsts = {}
    for m in re.finditer(rf"^## (\d+)\. \[({TS})[-–]({TS})\]\s*(.*)$", md, re.M):
        firsts.setdefault(page_of.get(m.group(1), 0), (m.group(1), m.group(4).strip()))
    data = json.dumps({str(k): f"{n} · {t}" if t else f"Section {n}" for k, (n, t) in firsts.items()}, ensure_ascii=False)
    top = (f'<span class="pages" id="pages" data-n="{pages}" data-first=\'{esc(data)}\'>'
           f'<button type="button" data-go="-1" aria-label="Previous page">‹</button>'
           f'<span class="pg-now" id="pg-now">Page 1 of {pages}</span>'
           f'<button type="button" data-go="1" aria-label="Next page">›</button></span>')
    bottom = (f'<nav class="pager" id="pager" aria-label="Transcript pages">'
              f'<button type="button" data-go="-1" id="pg-prev"></button>'
              f'<span class="pg-dots" id="pg-dots">{"".join(f"<button type=button data-page={k + 1} aria-label=\"Page {k + 1}\"></button>" for k in range(pages))}</span>'
              f'<button type="button" data-go="1" id="pg-next" class="primary"></button></nav>')
    return top, bottom


CLAIM_ORDER = ("contradicted", "outdated", "disputed", "unverified", "supported")
CLAIM_NAMES = {"supported": "Supported", "disputed": "Disputed", "contradicted": "Contradicted", "outdated": "Outdated", "unverified": "Couldn't check"}


def claims_html(folder: Path, url_base: str | None, para_starts: list[float]) -> str:
    """The agent's fact-check scan (claims.json, held to the transcript by check-claims) as a review queue.
    Questionable claims come first; every claim stays listed until a person reviews it, and after."""
    f = folder / "claims.json"
    if not f.exists():
        return ""
    try:
        doc = json.loads(f.read_text())
    except ValueError:
        return ""
    claims = sorted(doc.get("claims") or [], key=lambda c: (CLAIM_ORDER.index(c.get("suggest", "unverified")) if c.get("suggest") in CLAIM_ORDER else 9, c.get("t", 0)))
    if not claims:
        return ""
    counts = {k: sum(1 for c in claims if c.get("suggest") == k) for k in CLAIM_ORDER}
    summary = " · ".join(f"{n} {CLAIM_NAMES[k].lower()}" for k, n in counts.items() if n)
    items = []
    for c in claims:
        t = float(c.get("t") or 0)
        para = max([p for p in para_starts if p <= t] or [0])
        srcs = "".join(f'<li><a href="{esc(e["url"])}" target="_blank" rel="noopener">{esc(e.get("title", e["url"]))}</a>'
                       f'{" <span class=d>" + esc(e["date"]) + "</span>" if e.get("date") else ""}<br>{esc(e.get("says", ""))}</li>'
                       for e in c.get("evidence") or [])
        lab = c.get("suggest", "unverified")
        items.append(
            f'<li class="claim" id="claim-{esc(c["id"])}" data-id="{esc(c["id"])}" data-suggest="{esc(lab)}">'
            f'<div class="ch"><span class="lab lab-{esc(lab)}">Agent suggests: {esc(CLAIM_NAMES.get(lab, lab))}</span>'
            f'{ts_anchor(hms(t), t, url_base)}<a class="goto" href="#t-{int(para)}">in transcript</a></div>'
            f'<p class="cq">&ldquo;{esc(c.get("quote", ""))}&rdquo;</p>'
            f'<p class="cc">{esc(c.get("claim", ""))}</p>'
            f'<p class="cw">{esc(c.get("why", ""))}</p>'
            f'{"<ul class=src>" + srcs + "</ul>" if srcs else "<p class=cw><em>No source found.</em></p>"}'
            f'<div class="rv"><span class="rv-l">Your call:</span>'
            f'<button type="button" data-d="agree">Agree</button><button type="button" data-d="disagree">Disagree</button>'
            f'<button type="button" data-d="needs-more">Needs a closer look</button>'
            f'<input type="text" class="rv-note" placeholder="Note (optional)" aria-label="Review note" maxlength="500">'
            f'<span class="rv-s" aria-live="polite"></span></div></li>')
    return (f'<h2 id="claims">Claims to review</h2>'
            f'<p class="claims-intro">The agent scanned the talk for checkable claims and suggests a label for each, with its sources. '
            f'Nothing is settled until you review it. <span id="claims-n">{len(claims)} claims</span> · {summary}. '
            f'Checked {esc(doc.get("scanned", ""))}; the talk is from {esc(doc.get("talk_date", "?"))}.</p>'
            f'<p class="claims-off" id="claims-off">Reviews save on the published page.</p>'
            f'<ol class="claims">{"".join(items)}</ol>')


